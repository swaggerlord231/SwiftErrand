# Copy this file to .env and adjust the values for your environment.
# The settings module loads .env automatically; real environment variables
# always take precedence over values in this file.

# Core settings -------------------------------------------------------------
# Set to False in production.
DJANGO_DEBUG=True

# Use a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hostnames the site is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins trusted for CSRF (scheme + host), e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://swifterrand.com,https://www.swifterrand.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production TLS ------------------------------------------------------------
# Only applied when DJANGO_DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Email ---------------------------------------------------------------------
# Development default prints emails to the console.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP example:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.yourprovider.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=no-reply@swifterrand.com
# DJANGO_EMAIL_HOST_PASSWORD=your-smtp-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=Swift Errand <no-reply@swifterrand.com>
